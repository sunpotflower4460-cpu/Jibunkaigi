{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "declaration": true,
    "isolatedModules": true
  },
  "include": ["src/**/*.ts"],
  // Test files run under tsx (see `npm test`); exclude them from the library
  // typecheck so node:test types and .ts-extension imports are not required.
  "exclude": ["src/**/*.test.ts"]
}
