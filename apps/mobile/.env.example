# Firebase config for Expo Universal app.
# Do not commit real production secrets here.
# Firebase web config values are not Gemini secrets, but keep real values in local env files.
# Copy this file to .env and fill in real values for local development.
EXPO_PUBLIC_JIBUNKAIGI_APP_ID=self-conf-v10-mobile-dev
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
