# Jibunkaigi Expo Universal environment example
# Copy this file to .env locally.
# Do not commit .env.
# Do not put Gemini API keys in Expo env.
# App ID used for Firestore path:
# artifacts/{appId}/users/{uid}/...
EXPO_PUBLIC_JIBUNKAIGI_APP_ID=
# Firebase Web config for Expo Universal app.
# These values come from Firebase Console.
# Do not commit real values to GitHub.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Cloudflare Worker base URL.
# Example: https://your-worker.your-subdomain.workers.dev
# Do not put Gemini API Key here.
EXPO_PUBLIC_JIBUNKAIGI_API_BASE_URL=
