rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAllowedAppId(appId) {
      return appId == "self-conf-v10-mobile" || appId == "self-conf-v10-mobile-dev";
    }

    match /artifacts/{appId}/users/{uid}/sessions/{sessionId} {
      allow read, write: if isAllowedAppId(appId) && request.auth != null && request.auth.uid == uid;

      match /messages/{messageId} {
        allow read, write: if isAllowedAppId(appId) && request.auth != null && request.auth.uid == uid;
      }
    }

    match /artifacts/{appId}/users/{uid}/profile/settings {
      allow read, write: if isAllowedAppId(appId) && request.auth != null && request.auth.uid == uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
